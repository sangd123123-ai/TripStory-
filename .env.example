PORT=8080
NODE_ENV=production
# Development only: set true to clear vendor sample data on server start.
CLEAR_VENDOR_SAMPLE_DATA=false

# Backend database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tripstory?appName=Cluster0
# Optional aliases used by a few legacy scripts.
MONGO_URI=
MONGO_URL=

# JWT auth
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
# Optional: protects /admin-auth/register when set.
ADMIN_SIGNUP_SECRET=
# Optional legacy JWT fallbacks used by the notice router.
JWT_SECRET=
JWT_USER_SECRET=
JWT_ADMIN_SECRET=
ADMIN_JWT_SECRET=

# Frontend origin allowed by CORS and OAuth redirects.
CLIENT_ORIGIN=https://trip-story-rose.vercel.app

# Social login
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://tripstory-api.onrender.com/auth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tripstory-api.onrender.com/auth/google/callback

# Kakao local search / place coordinate lookup
KAKAO_REST_KEY=

# AI image/story generation
OPENAI_API_KEY=

# Weather/course APIs
KMA_SERVICE_KEY=
KTO_SERVICE_KEY=
OPENWEATHER_API_KEY=

# Optional API endpoint overrides. Leave blank unless the public endpoints change.
WEATHER_API_URL=
KTO_API_URL=
KTO_LOC_API_URL=
KTO_AREACODE_API_URL=

# Optional network proxy settings for restricted networks.
HTTPS_PROXY=
HTTP_PROXY=

# Optional seed script controls.
SEED_AUTHOR_ID=
SEED_AUTHOR_NAME=
SEED_PLACEHOLDER_IMG=
